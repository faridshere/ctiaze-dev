# ctiaze-dev — copy to .env.local (gitignored). The only variable this portal reads.
# Use a READ-ONLY user (role: read on db "ctiaze") on the self-hosted MongoDB (AWS box, via the SSH
# tunnel on 127.0.0.1:27018; Atlas is gone since 16 Oct 2026). The MCP server never writes.
# Production value lives in the ctiaze-dev Vercel project → Settings → Environment
# Variables; redeploy after changing it (env vars bind at build time).
MONGO_URI_READONLY=mongodb://<read-only-user>:<password>@127.0.0.1:27018/ctiaze?authSource=admin
