{
  "name": "skopnix",
  "version": "0.1.0",
  "description": "Check an SBOM against skopnix.com threat intelligence: CVEs, CISA KEV, EPSS and the threat actors cited for them.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "skopnix": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "sbom",
    "cyclonedx",
    "spdx",
    "cve",
    "kev",
    "epss",
    "threat-intelligence",
    "skopnix"
  ],
  "homepage": "https://skopnix.com",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/sync-action.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "check:action": "node scripts/sync-action.mjs --check",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  }
}
